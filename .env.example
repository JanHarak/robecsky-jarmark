# Supabase browser client configuration.
# In Vite, only variables prefixed with VITE_ are exposed to the frontend bundle.
# The publishable key is safe to ship to browsers; NEVER put SERVICE_ROLE / SECRET
# keys, the DB password, or a postgres connection string in any VITE_ variable.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX"
